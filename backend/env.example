# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_api_key_here

# Supabase PostgreSQL Configuration (Session Pooler - IPv4 compatible)
SUPABASE_HOST=postgres.your-project-id.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_supabase_password_here

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenCellID API
OPENCELLID_API_KEY=your_opencellid_api_key_here

# Authentication (optional - uses SUPABASE_KEY if not provided)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Session Management
SESSION_TIMEOUT_MINUTES=30
INACTIVITY_TIMEOUT_MINUTES=60

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REPORTS_PER_HOUR=10
RATE_LIMIT_QUESTIONS_PER_HOUR=30
RATE_LIMIT_PUBLIC_PER_HOUR=100

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

