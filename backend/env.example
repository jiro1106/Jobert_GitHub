# Supabase PostgreSQL Configuration
SUPABASE_HOST=db.your-project-id.supabase.co
SUPABASE_PORT=6543
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_supabase_password_here

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-key.json

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather API
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenCellID API
OPENCELLID_API_KEY=your_opencellid_api_key_here

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=firebase

# Server
HOST=0.0.0.0
PORT=8000
